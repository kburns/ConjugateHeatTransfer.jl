#1) Specify the Body Shape: Specify as a parametric curve from 0 to 2*pi.
# The structure of A will be: Acoeff = [A_0,A_1,...A_{N}], the Laurent Series coeffs.
# Complex Potential Form: W= conj(U)*z + Sum_{n=0}^{N-1}A_n z^{-n}.
function bodyshape(θ) #can be recentered
    outp = exp.(im*θ).*(1 .+ 0.2*sin.(3*θ)) ;
    # This is an example function! If we like we can take a user input here!
    return outp;
end


