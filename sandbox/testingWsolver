################ PREDEFINED PARAMETERS ###############
NB=200; #number of points on the body to be sampled.
NL = 40; # Number of terms in the Laurent Series fit of the solution. (There will also be the additive constant which isn't specified here.)
U=1im+1;

#Define centers for the Laurent Series
zc1=-2+0im;
zc2=2im;
zc3=-2im;
zc4=+4;
ZCs=[zc1,zc2,zc3,zc4]

#Here you would reference the body object.

#User seletcts to bodies to be created and then makes a vector "bod=[bod1,bod2,bod3,...]"
b1=DirichletBody(zc1, θ->bodyshape(0), θ->0)
b2=DirichletBody(zc2, θ->bodyshape(0), θ->0)
bodies=[b1,b2];

W = solve_pot_flow(bodies, U, NB, NL)

gridsize=200
x = Vector(range(-5, 5, length=gridsize));
y = Vector(range(-5, 5, length=gridsize));
z = @. x' + im*y ;
zvec=reshape(z,gridsize*gridsize,1)


#Evaluate the Solution
